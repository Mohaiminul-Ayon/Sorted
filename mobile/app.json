{
  "expo": {
    "name": "Sorted",
    "slug": "sorted",
    "version": "0.1.2",
    "scheme": "sorted",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sorted.v1"
    },
    "android": {
      "package": "app.sorted.v1",
      "adaptiveIcon": {
        "backgroundColor": "#E8F1F8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Sorted uses the microphone only when you tap Speak, to turn your words into an Inbox title.",
          "speechRecognitionPermission": "Sorted uses on-device speech recognition only when you tap Speak."
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["text/*"],
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ]
  }
}