{
  "expo": {
    "name": "Sorted",
    "slug": "sorted",
    "version": "0.2.0",
    "scheme": "sorted",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sorted.v1"
    },
    "android": {
      "package": "app.sorted.v1",
      "adaptiveIcon": {
        "backgroundColor": "#E8F1F8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#4A7C9B",
          "defaultChannel": "sorted-quiet"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Sorted adds a calendar event only after you confirm a scheduled task."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Sorted uses the microphone only when you tap Speak, to turn your words into an Inbox title.",
          "speechRecognitionPermission": "Sorted uses on-device speech recognition only when you tap Speak."
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["text/*"],
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ]
  }
}